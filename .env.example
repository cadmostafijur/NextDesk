# NexDesk environment (copy to .env — never commit real secrets)

NEXDESK_BIND=0.0.0.0:7800
NEXDESK_API_BIND=0.0.0.0:7801

# Must be >= 32 characters
NEXDESK_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# coturn REST API shared secret (>= 16 chars)
NEXDESK_TURN_SECRET=replace-turn-shared-secret
NEXDESK_TURN_URLS=stun:stun.l.google.com:19302,turn:turn.example.com:3478?transport=udp
NEXDESK_TURN_TTL=3600

NEXDESK_MAX_CONNECT_PER_MIN=20
NEXDESK_ALLOW_DEV_TOKENS=true

# Optional persistence (MVP signaling works in-memory without these)
DATABASE_URL=postgres://nexdesk:nexdesk@127.0.0.1:5432/nexdesk
REDIS_URL=redis://127.0.0.1:6379

RUST_LOG=info,nexdesk_signaling=debug
